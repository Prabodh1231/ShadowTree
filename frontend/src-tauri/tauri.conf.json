{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ShadowTree",
  "version": "0.1.0",
  "identifier": "dev.shadowtree.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "ShadowTree",
        "width": 1440,
        "height": 900,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval' 'unsafe-eval'",
        "worker-src": "'self' blob:",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: http://127.0.0.1:8000",
        "font-src": "'self' data:",
        "base-uri": "'none'",
        "object-src": "'none'",
        "form-action": "'none'",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:8000 https://events.desertant.com https://huggingface.co https://*.huggingface.co https://*.hf.co"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval' 'unsafe-eval'",
        "worker-src": "'self' blob:",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: http://127.0.0.1:8000",
        "font-src": "'self' data:",
        "base-uri": "'none'",
        "object-src": "'none'",
        "form-action": "'none'",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:8000 https://events.desertant.com https://huggingface.co https://*.huggingface.co https://*.hf.co ws://127.0.0.1:5173 http://127.0.0.1:5173"
      }
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
